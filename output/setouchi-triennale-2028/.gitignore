# Versioned review materials; full print exports and downloaded inputs stay local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/GIT-CONTENTS.md
!/index.html
!/manifest.json
!/SHA256SUMS

!/build/
/build/*
!/build/*.py
!/build/*.cc
!/build/compile-command.json

!/previews/
/previews/*
!/previews/world/
!/previews/japan/

!/catalogs/
/catalogs/*
!/catalogs/*.pdf

!/proposal/
/proposal/*
!/proposal/*.md
!/proposal/*.json
!/proposal/*.pdf

!/prototypes/
/prototypes/*
!/prototypes/coral-reef/

!/sources/
/sources/*
!/sources/*.json
!/sources/data-quality.md
!/sources/resource-color-key.html
!/sources/petroleum-explorer.html
!/sources/petroleum-*.csv
