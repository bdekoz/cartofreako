# Versioned India data/review package; bulk caches and full SVG exports stay local.
/*
!/.gitignore
!/.gitattributes
!/GIT-CONTENTS.md
!/GIT-SHA256SUMS

!/enrichment/
/enrichment/*
!/enrichment/*.json

!/enrichment/observations/
/enrichment/observations/*
!/enrichment/observations/*.json
!/enrichment/observations/openaq-station-days.csv.gz
!/enrichment/observations/openaq-paired-days.csv.gz
!/enrichment/observations/episodes.csv.gz
!/enrichment/observations/matched-station-days-2025-2026.csv.gz
!/enrichment/observations/station-month-coverage.csv.gz
!/enrichment/observations/xkdr-2024-station-days.csv.gz
!/enrichment/observations/xkdr-2024-*-coverage.csv.gz

!/enrichment/context/
/enrichment/context/*
!/enrichment/context/*.json
!/enrichment/context/*.csv.gz

!/enrichment/model/
/enrichment/model/*
!/enrichment/model/*.json
!/enrichment/model/*.geojson
!/enrichment/model/*.csv.gz
!/enrichment/model/*.npz

!/enrichment/profiles/
/enrichment/profiles/*
!/enrichment/profiles/*.json
!/enrichment/profiles/*.geojson
!/enrichment/profiles/*.csv.gz

!/enrichment/figures/
/enrichment/figures/*
!/enrichment/figures/*.png
!/enrichment/figures/*.pdf

!/enrichment/atlas-preview/
/enrichment/atlas-preview/*
!/enrichment/atlas-preview/*.png

!/enrichment/openaq/
/enrichment/openaq/*
!/enrichment/openaq/*.json
!/enrichment/openaq/*.csv.gz

# Preserve the small, time-sensitive public fire snapshot and acquisition metadata.
!/enrichment/raw/
/enrichment/raw/*
!/enrichment/raw/download-receipts.json
!/enrichment/raw/firms/
/enrichment/raw/firms/*
!/enrichment/raw/firms/*.csv
!/enrichment/raw/discovery/
/enrichment/raw/discovery/*
!/enrichment/raw/discovery/firms-catalog.json
!/enrichment/raw/discovery/xkdr-files.json
!/enrichment/raw/discovery/xkdr-meta.json
!/enrichment/raw/discovery/xkdr-stations.txt
!/enrichment/raw/discovery/zenodo-record.txt

!/sources/
/sources/*
!/sources/*.json
!/sources/asia-pm25/
/sources/asia-pm25/*
!/sources/asia-pm25/*.json
!/sources/asia-pm25/openaq-station-days.csv.gz
!/sources/data/
/sources/data/*
!/sources/data/anthropocene/
/sources/data/anthropocene/*
!/sources/data/anthropocene/pm25-*.json
!/sources/research/
/sources/research/*
!/sources/research/*.json
!/sources/research/*.csv
