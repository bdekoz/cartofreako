{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bdekoz.github.io/cartofreako/contracts/pass-status-v1.schema.json",
  "title": "Cartofreako current pass status manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "checkedOn",
    "axes",
    "passes"
  ],
  "properties": {
    "schemaVersion": {
      "const": "cartofreako-pass-status-v1"
    },
    "checkedOn": {
      "type": "string",
      "format": "date"
    },
    "axes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "independent",
        "lifecycle",
        "maturity"
      ],
      "properties": {
        "independent": {
          "const": true
        },
        "lifecycle": {
          "type": "string",
          "minLength": 1
        },
        "maturity": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "passes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 14,
      "items": {
        "$ref": "#/$defs/pass"
      }
    }
  },
  "$defs": {
    "pass": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "family",
        "current",
        "lifecycle",
        "maturity",
        "defaultGenerated",
        "releaseEligible",
        "acceptedOn",
        "artifactManifest",
        "statusReason",
        "claimBoundary"
      ],
      "properties": {
        "id": {
          "enum": [
            "anthropocene-particulate-2025",
            "anthropocene-particulate-2026",
            "anthropocene-land-temperature-2025",
            "anthropocene-land-temperature-2026",
            "bathymetry-roulette",
            "bathymetry-hamonshu",
            "anthropocene-marine-heatwave-2025",
            "anthropocene-marine-heatwave-2026",
            "anthropocene-ocean-thermal-season-2025",
            "anthropocene-ocean-thermal-season-2026",
            "anthropocene-coastal-compound-heat-2025",
            "anthropocene-coastal-compound-heat-2026",
            "anthropocene-heat-particulate-coexposure-2025",
            "anthropocene-heat-particulate-coexposure-2026"
          ]
        },
        "family": {
          "enum": [
            "particulate-observation-atlas",
            "temperature-field",
            "bathymetry-art",
            "derived-climate-review"
          ]
        },
        "current": {
          "const": true
        },
        "lifecycle": {
          "enum": [
            "standard",
            "optional"
          ]
        },
        "maturity": {
          "enum": [
            "accepted-experimental",
            "prototype"
          ]
        },
        "defaultGenerated": {
          "type": "boolean"
        },
        "releaseEligible": {
          "type": "boolean"
        },
        "acceptedOn": {
          "type": "string",
          "format": "date"
        },
        "artifactManifest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "artifactCount"
          ],
          "properties": {
            "path": {
              "const": "contracts/standard-artifact-manifest-v1.json"
            },
            "artifactCount": {
              "enum": [
                0,
                6
              ]
            }
          }
        },
        "statusReason": {
          "type": "string",
          "minLength": 1
        },
        "claimBoundary": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    }
  }
}
