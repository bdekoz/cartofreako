{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bdekoz.github.io/cartofreako/contracts/anthropocene-water-debris-experiment-v1.schema.json",
  "title": "Cartofreako anthropocene water-debris experiment v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "lifecycle", "checkedOn", "passFamily", "years",
    "evidenceClasses", "sources", "depthStations", "layouts", "style",
    "claimBoundary", "promotion"
  ],
  "properties": {
    "schemaVersion": {"const": "cartofreako-anthropocene-water-debris-experiment-v1"},
    "lifecycle": {"const": "exploration-only"},
    "checkedOn": {"type": "string", "format": "date"},
    "passFamily": {"const": "anthropocene-water-debris"},
    "years": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["year", "editionStatus", "dataThrough"],
        "properties": {
          "year": {"enum": [2025, 2026]},
          "editionStatus": {"enum": ["complete", "partial"]},
          "dataThrough": {"type": "string", "format": "date"}
        }
      }
    },
    "evidenceClasses": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "renderDisposition", "depthRule"],
        "properties": {
          "id": {"enum": ["observed-shoreline", "observed-surface-sample", "modeled-concentration", "modeled-river-emission", "cleanup-operation", "depth-profile"]},
          "renderDisposition": {"enum": ["rendered-observation", "context-only", "UNAVAILABLE"]},
          "depthRule": {"enum": ["observed-only", "not-applicable", "UNAVAILABLE-not-zero"]}
        }
      }
    },
    "sources": {
      "type": "array", "minItems": 5,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "authority", "title", "url", "licenseSpdx", "sourcePeriod", "renderRole", "supportsClasses", "limitation"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "authority": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "url": {"type": "string", "format": "uri"},
          "licenseSpdx": {"type": "string", "minLength": 1},
          "sourcePeriod": {"type": "string", "minLength": 1},
          "renderRole": {"enum": ["observed-geometry", "context-only"]},
          "supportsClasses": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "limitation": {"type": "string", "minLength": 1},
          "sourceReceiptSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "depthStations": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "date", "longitude", "latitude", "maximumSampleDepthM", "sourceId", "evidenceClass"],
        "properties": {
          "id": {"type": "string", "pattern": "^station-[1-5]$"},
          "date": {"type": "string", "format": "date"},
          "longitude": {"type": "number", "minimum": -180, "maximum": 180},
          "latitude": {"type": "number", "minimum": -90, "maximum": 90},
          "maximumSampleDepthM": {"type": "number", "exclusiveMinimum": 0},
          "sourceId": {"const": "ocean-cleanup-depth-2020"},
          "evidenceClass": {"const": "depth-profile"}
        }
      }
    },
    "layouts": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "projectionDirectory", "runtimeProjection", "frame", "sourceBase", "suffix"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "projectionDirectory": {"type": "string", "minLength": 1},
          "runtimeProjection": {"type": "string", "minLength": 1},
          "frame": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "exclusiveMinimum": 0}},
          "sourceBase": {"type": "string", "minLength": 1},
          "suffix": {"type": "string", "minLength": 1}
        }
      }
    },
    "style": {
      "type": "object", "additionalProperties": false,
      "required": ["observedFieldMaximumOpacity", "titleScale"],
      "properties": {
        "observedFieldMaximumOpacity": {"const": 0.6},
        "titleScale": {"const": 2}
      }
    },
    "claimBoundary": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "promotion": {
      "type": "object", "additionalProperties": false,
      "required": ["standardLifecycleAuthorized", "defaultGenerationAuthorized", "publicReleaseAuthorized"],
      "properties": {
        "standardLifecycleAuthorized": {"const": false},
        "defaultGenerationAuthorized": {"const": false},
        "publicReleaseAuthorized": {"const": false}
      }
    }
  }
}
