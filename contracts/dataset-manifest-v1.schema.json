{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartofreako-dataset-v1",
  "type": "object",
  "required": [
    "schema",
    "dataset_id",
    "state",
    "requested_as_of",
    "resolved_at",
    "product_groups",
    "sources",
    "files",
    "bindings",
    "implementation",
    "validation",
    "manifest_sha256",
    "registry",
    "products"
  ],
  "properties": {
    "schema": {
      "const": "cartofreako-dataset-v1"
    },
    "state": {
      "const": "validated"
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,159}$"
    },
    "requested_as_of": {
      "type": "string",
      "format": "date-time"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    "product_groups": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "standard",
          "atlas",
          "anthropocene-optional"
        ]
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "acquisition",
          "files",
          "coverage"
        ]
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "bytes",
          "role"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "role": {
            "type": "string"
          }
        }
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "implementation": {
      "type": "object",
      "required": [
        "revision",
        "dirty",
        "files"
      ]
    },
    "validation": {
      "type": "object",
      "required": [
        "status",
        "checks"
      ],
      "properties": {
        "status": {
          "const": "passed"
        },
        "checks": {
          "type": "array",
          "minItems": 1
        }
      }
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "registry": {
      "type": "object",
      "required": [
        "schema",
        "years",
        "groups",
        "policies"
      ]
    },
    "products": {
      "type": "object",
      "required": [
        "plates"
      ]
    }
  }
}
